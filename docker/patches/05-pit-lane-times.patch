diff --git a/src/routes/session.js b/src/routes/session.js
index 41aa379..c24ff59 100644
--- a/src/routes/session.js
+++ b/src/routes/session.js
@@ -93,6 +93,21 @@ function createSessionRouter(f1Client) {
     router.get('/radio', getRadioHandler);
     router.get('/team-radio', getRadioHandler);
 
+    /**
+     * GET /api/pitstops
+     * Retrieves pit lane times (PitLaneTimeCollection channel), keyed by racing number: PitTimes holds the entries
+     * the feed currently shows, PitStops every completed stop of the session as { Lap, Duration } in seconds.
+     */
+    router.get('/pitstops', (req, res) => {
+        try {
+            const pitLaneTimes = f1Client.getPitLaneTimes() || {};
+            res.status(200).json({ PitTimes: pitLaneTimes.PitTimes || {}, PitStops: f1Client.getPitStops() });
+        } catch (error) {
+            console.error('[API Error] Failed to retrieve pit lane times:', error);
+            res.status(500).json({ error: 'Internal server error while querying PitLaneTimeCollection.' });
+        }
+    });
+
     return router;
 }
 
