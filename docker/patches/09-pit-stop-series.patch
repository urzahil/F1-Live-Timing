diff --git a/src/routes/session.js b/src/routes/session.js
index fa2484b..5fde27c 100644
--- a/src/routes/session.js
+++ b/src/routes/session.js
@@ -129,6 +129,30 @@ function createSessionRouter(f1Client) {
         }
     });
 
+    /**
+     * GET /api/pit-stop-series
+     * Retrieves the raw PitStopSeries channel (stationary and pit lane time per stop, keyed by racing number), plus
+     * the same stops flattened into one list ordered by Timestamp, newest first.
+     */
+    router.get('/pit-stop-series', (req, res) => {
+        try {
+            const series = f1Client.getPitStopSeries() || {};
+            const stops = [];
+            for (const [racingNumber, entries] of Object.entries(series.PitTimes || {})) {
+                const list = Array.isArray(entries) ? entries : Object.values(entries || {});
+                for (const entry of list) {
+                    if (!entry || !entry.PitStop) continue;
+                    stops.push({ RacingNumber: entry.PitStop.RacingNumber || racingNumber, Timestamp: entry.Timestamp, ...entry.PitStop });
+                }
+            }
+            stops.sort((a, b) => String(b.Timestamp || '').localeCompare(String(a.Timestamp || '')));
+            res.status(200).json({ Stops: stops, PitStopSeries: series });
+        } catch (error) {
+            console.error('[API Error] Failed to retrieve PitStopSeries:', error);
+            res.status(500).json({ error: 'Internal server error while querying PitStopSeries.' });
+        }
+    });
+
     return router;
 }
 
